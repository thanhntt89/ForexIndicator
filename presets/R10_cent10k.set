; R10 = live config for a 10,000-unit cent account, and the backtest that is its baseline.
; Same file for both. Base: StrategyTester9.htm (defaults + 12R cap).
; Changed: lot fixed 0.1 (min = max), MinRecLevel 3, DCA backstop SL on, research log on.
; Fixed 0.1 lot on 10,000 is run #7's 0.01 lot on 1,000 scaled x10: every leg at the floor,
; the 15% and 12R caps scale with it, so percentages match run #7 exactly.
; Tester: XAUUSD M15, 2024.02.01-2024.12.31, Every tick, DEPOSIT 10000, spread 400 on a
; 3-digit symbol (= $0.40). Needs EA build 2026-09-30.2-research or later.
; InpTesterGMTOffset=2: the tester's server clock is UTC+2/+3 (trading resumes 01:00 server),
;   so with 0 the 07-20 session filter ran 2-3h early vs live. Winter-exact, 1h off in summer.
;   Tester only -- live uses TimeGMT() and ignores this input.
; Live: attach to XAUUSDc on the cent account (balance 10,000 USC) with this file.
InpIndicatorName=QuantEdge_RSI
InpEnableAutoTrading=true
InpMagicNumber=20260805
InpSlippage=10
InpUseGate1RecLevel=true
InpMinRecLevel=3
InpAllowCaution=true
InpRecLevelMinSamples=20
InpUseGate2Confidence=true
InpMinConfidence=50
InpUseGate3Staleness=true
InpMaxSurvivalFloor=0.15
InpUseGate5Spread=true
InpMaxSpreadPoints=40
InpMaxSpreadPctOfTP1=8
InpUseSessionFilter=true
InpTesterGMTOffset=2
InpSessionStartHour=7
InpSessionEndHour=20
InpUseDailyLossCap=false
InpMaxDailyLosses=0
InpMaxDailyLossPct=0
InpUseWeeklyDDStop=false
InpMaxWeeklyDDPct=10
InpUseMonthlyDDStop=false
InpMaxMonthlyDDPct=15
InpUseADXGate=false
InpUseEconCalGate=false
InpUseGate10PriceLoc=true
InpUsePriceLocSLSide=true
InpUsePriceLocTPSide=true
InpPriceLocMaxPct=25
InpPriceLocMaxProbSL=50
InpUseGate11EV=true
InpMinEV=0
InpUseGate12FillRR=true
InpMinFillRR=0.5
InpUseSignalRetry=true
InpRetryMaxBars=2
InpInvalidateOnTP1=true
InpTPMode=0
InpUseStructuralSLTP=true
InpTP1LotRatio=0.6
InpUseTrailing=true
InpTrailATRMult=1.5
InpTrailATRPeriod=14
InpUsePositiveDCA=true
InpPosDCAMaxOrders=4
InpPosDCAATRMult=2.5
InpPosDCAHalfClosePct=50
InpUseNegativeDCA=true
InpNegDCAMaxOrders=10
InpNegDCATriggerPct=50
InpNegDCAATRMult=2.5
InpNegDCAMaxDDPct=15
InpBasketMaxLossR=12
InpNegDCABEClose=true
InpNegDCABEOffsetPip=5
InpDCAProfitLockR=1
InpDCAMinSpacingPts=1500
InpDCAMinIntervalMin=5
InpUseDCABackstopSL=true
InpDCABackstopBufferMult=1.3
InpDefaultRiskPct=0.5
InpMaxLotSize=0.1
InpMinLotSize=0.1
InpUseRecoveryMode=false
InpRecoveryLotMult=1.3
InpRecoveryMaxTrades=5
InpRecoveryMaxConsLoss=2
Ind_RSIPeriod=14
Ind_FastMAPeriod=2
